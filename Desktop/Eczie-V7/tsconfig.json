{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    "moduleResolution": "node",
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "jest",
      "node",
      "react",
      "react-native"
    ],
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "Frontend/src",
    "Backend/convex",
    "jest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "docs",
    "specs",
    "Eczie-V7-codex-speckit"
  ],
  "extends": "expo/tsconfig.base"
}
